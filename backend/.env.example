CUSD_ISSUER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CUSD_ISSUER_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FAUCET_AMOUNT=500
# Lista separada por comas. Incluir siempre localhost:4200 (Angular dev server).
CORS_ALLOWED_ORIGIN=http://localhost:8080,http://localhost:4200

# DB_DRIVER: pgsql (default, Render), mysql (MySQL Workbench/XAMPP local),
# o sqlite (mock local sin servidor, ver seed.php).
DB_DRIVER=pgsql

# Postgres: Render inyecta DATABASE_URL automáticamente al conectar la DB al
# servicio. En local, dejar DATABASE_URL vacío y usar las variables sueltas.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=caja
PGUSER=postgres
PGPASSWORD=

# MySQL (solo si DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caja
DB_USER=root
DB_PASSWORD=
