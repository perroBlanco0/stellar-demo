CUSD_ISSUER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CUSD_ISSUER_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FAUCET_AMOUNT=500
# Lista separada por comas de orígenes permitidos en producción.
# Los orígenes localhost (cualquier puerto) siempre se aceptan.
# Agregar aquí la URL del Static Site del panel, ej: https://stellar-demo-panel.onrender.com
CORS_ALLOWED_ORIGIN=http://localhost:4200,https://stellar-demo-panel.onrender.com

# DB_DRIVER: pgsql (default, Render), mysql (MySQL Workbench/XAMPP local),
# o sqlite (mock local sin servidor, ver seed.php).
DB_DRIVER=pgsql

# Postgres: Render inyecta DATABASE_URL automáticamente al conectar la DB al
# servicio. En local, dejar DATABASE_URL vacío y usar las variables sueltas.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=caja
PGUSER=postgres
PGPASSWORD=

# MySQL (solo si DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caja
DB_USER=root
DB_PASSWORD=

# Correo transaccional (bienvenida, gasto aprobado, codigo de recuperacion).
# Sin RESEND_API_KEY los correos se omiten en silencio y la app sigue igual.
RESEND_API_KEY=
# Remitente de los correos. Con la cuenta gratis de Resend solo puedes enviar
# desde onboarding@resend.dev al correo dueno de la cuenta; con dominio
# verificado usa tu propio remitente, ej: Cosigna <hola@tudominio.cl>
CORREO_DESDE=Cosigna <onboarding@resend.dev>
